{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuzzle",
  "version": "0.3.0",
  "identifier": "app.nuzzle.desktop",
  "build": {
    "beforeDevCommand": "python3 scripts/build_frontend.py",
    "beforeBuildCommand": "python3 scripts/build_frontend.py",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nuzzle Companion Studio",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "visible": true
      },
      {
        "label": "companion",
        "title": "Nuzzle Companion",
        "url": "mini.html",
        "width": 300,
        "height": 420,
        "minWidth": 220,
        "minHeight": 280,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  }
}
